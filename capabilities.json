{
    "dataRoles": [
        {
            "displayName": "Axis",
            "name": "category",
            "kind": "Grouping",
            "description": "Outer category on the axis. Each category holds one cluster of bars.",
            "displayNameKey": "Role_Axis",
            "descriptionKey": "Role_Axis_Desc"
        },
        {
            "displayName": "Group (clustered)",
            "name": "group",
            "kind": "Grouping",
            "description": "Bars placed side by side inside each axis category.",
            "displayNameKey": "Role_Group",
            "descriptionKey": "Role_Group_Desc"
        },
        {
            "displayName": "Stack (legend)",
            "name": "stack",
            "kind": "Grouping",
            "description": "Series stacked on top of each other inside every bar.",
            "displayNameKey": "Role_Stack",
            "descriptionKey": "Role_Stack_Desc"
        },
        {
            "displayName": "Values",
            "name": "values",
            "kind": "Measure",
            "displayNameKey": "Role_Values"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "group": {
                        "max": 1
                    },
                    "stack": {
                        "max": 1
                    },
                    "values": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "bind": {
                                "to": "category"
                            }
                        },
                        {
                            "bind": {
                                "to": "group"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 10000
                        }
                    }
                },
                "values": {
                    "group": {
                        "by": "stack",
                        "select": [
                            {
                                "bind": {
                                    "to": "values"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 60
                            }
                        }
                    }
                }
            }
        }
    ],
    "objects": {
        "general": {
            "properties": {
                "orientation": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "vertical",
                                "displayName": "Vertical (columns)",
                                "displayNameKey": "Orientation_Vertical"
                            },
                            {
                                "value": "horizontal",
                                "displayName": "Horizontal (bars)",
                                "displayNameKey": "Orientation_Horizontal"
                            }
                        ]
                    }
                },
                "stackMode": {
                    "type": {
                        "enumeration": [
                            {
                                "value": "stacked",
                                "displayName": "Stacked",
                                "displayNameKey": "StackMode_Stacked"
                            },
                            {
                                "value": "percent",
                                "displayName": "100% stacked",
                                "displayNameKey": "StackMode_Percent"
                            }
                        ]
                    }
                }
            }
        },
        "dataPoint": {
            "properties": {
                "fill": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "layout": {
            "properties": {
                "categoryPadding": {
                    "type": {
